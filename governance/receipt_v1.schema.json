{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairoseed.dev/schema/receipt_v1.schema.json",
  "title": "KAIROSEED receipt_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "epoch",
    "decision",
    "reason_code",
    "claim_atoms",
    "evidence_ids",
    "evidence_digest",
    "policy_digest",
    "timestamp"
  ],
  "properties": {
    "trace_id": {"type": "string", "minLength": 1},
    "epoch": {"type": ["integer", "string"]},
    "decision": {"enum": ["ALLOW", "DENY", "REVIEW"]},
    "reason_code": {"type": "string", "minLength": 1},
    "claim_atoms": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence_digest": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "subsystem": {"enum": ["GOVANA", "JIREH", "KAIROSEED"]},
    "scope_atoms": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "implementation_status": {
      "enum": ["SPECIFICATION", "STAGING", "VERIFIED_IMPLEMENTATION", "PRODUCTION"]
    }
  }
}
